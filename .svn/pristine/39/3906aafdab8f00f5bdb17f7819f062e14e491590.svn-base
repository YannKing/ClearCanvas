"dxa"/></w:tcPr><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:jc w:val="center"/><w:rPr><w:lang w:bidi="ar-SA"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:bidi="ar-SA"/></w:rPr><w:lastRenderedPageBreak/><w:pict><v:shape id="_x0000_i1027" type="#_x0000_t75" style="width:6in;height:330.4pt"><v:imagedata r:id="rId12" o:title="HotelMetalBlue_example"/></v:shape></w:pict></w:r></w:p></w:tc></w:tr></w:tbl><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="FigureTitle"/></w:pPr><w:r><w:t>Figure B.1.3.1-1</w:t></w:r><w:r><w:br/><w:t>PET image with Hot Metal Blue Palette applied.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="Heading4"/></w:pPr><w:bookmarkStart w:id="55" w:name="_Toc123636748"/><w:bookmarkStart w:id="56" w:name="_Toc172346082"/><w:r><w:t>B.1.3.2 Hot Metal Blue Color Palette Definition</w:t></w:r><w:bookmarkEnd w:id="55"/><w:bookmarkEnd w:id="56"/></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t>The ICC Profile shall define the sRGB space.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t xml:space="preserve">The value of Content Label </w:t></w:r><w:r><w:rPr><w:lang w:bidi="ar-SA"/></w:rPr><w:t>(0070,0080) shall be “HOT_METAL_BLUE”.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t>This color palette is defined to contain the values for Red Palette Color Lookup Table Descriptor (0028,1101), Green Palette Color Lookup Table Descriptor (0028,1102) and Blue Palette Color Lookup Table Descriptor (00</w:t></w:r><w:r><w:t>28,1103) defined in Table B.1.3.2-1.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="TableTitle"/></w:pPr><w:r><w:t>Table B.1.3.2-1</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/></w:rPr><w:br/></w:r><w:r><w:t>Hot Metal Blue Color Palette Descriptor</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="4500" w:type="dxa"/><w:jc w