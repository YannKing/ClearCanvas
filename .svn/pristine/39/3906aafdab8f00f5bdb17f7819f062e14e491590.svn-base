idi="ar-SA"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:bidi="ar-SA"/></w:rPr><w:lastRenderedPageBreak/><w:pict><v:shape id="_x0000_i1028" type="#_x0000_t75" style="width:6in;height:363.05pt"><v:imagedata r:id="rId13" o:title="PET20Step"/></v:shape></w:pict></w:r></w:p></w:tc></w:tr></w:tbl><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="FigureTitle"/></w:pPr><w:r><w:t>Figure B.1.4.1-1</w:t></w:r><w:r><w:br/><w:t>PET image with PET 20 Step Palette appli</w:t></w:r><w:r><w:t>ed.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="Heading4"/></w:pPr><w:bookmarkStart w:id="61" w:name="_Toc123636751"/><w:bookmarkStart w:id="62" w:name="_Toc172346085"/><w:r><w:t>B.1.4.2 PET 20 Step Color Palette Definition</w:t></w:r><w:bookmarkEnd w:id="61"/><w:bookmarkEnd w:id="62"/></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t>The ICC Profile shall define the sRGB space.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t xml:space="preserve">The value of Content Label </w:t></w:r><w:r><w:rPr><w:lang w:bidi="ar-SA"/></w:rPr><w:t>(0070,0080) shall be “PET_20_STEP”.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t>This color palette is defined to contain the values for Red Palette Color Lookup Table Descriptor (</w:t></w:r><w:r><w:t>0028,1101), Green Palette Color Lookup Table Descriptor (0028,1102) and Blue Palette Color Lookup Table Descriptor (0028,1103) defined in Table B.1.4.2-1.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="TableTitle"/></w:pPr><w:r><w:t>Table B.1.4.2-1</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/></w:rPr><w:br/></w:r><w:r><w:t>PET 20 Step Color Palette Descriptor</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="4500" w:type="dxa"/><w:jc w:val="center"/><w:tblBorders><w:top w:val="double" w:sz="6" w:space="0" w:color="auto"/><w:left w:val="single" w:sz