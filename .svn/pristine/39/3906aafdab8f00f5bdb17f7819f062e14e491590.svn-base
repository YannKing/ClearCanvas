f eqn="if lineDrawn pixelLineWidth 0"/><v:f eqn="sum @0 1 0"/><v:f eqn="sum 0 0 @1"/><v:f eqn="prod @2 1 2"/><v:f eqn="prod @3 21600 pixelWidth"/><v:f eqn="prod @3 21600 pixelHeight"/><v:f eqn="sum @0 0 1"/><v:f eqn="prod @6 1 2"/><v:f eqn="prod @7 21600 pixelWidth"/><v:f eqn="sum @8 21600 0"/><v:f eqn="prod @7 21600 pixelHeight"/><v:f eqn="sum @10 21600 0"/></v:formulas><v:path o:extrusionok="f" gradientshapeok="t" o:connecttype="rect"/><o:lock v:ext="edit" aspectratio="t"/></v:shapetype><v:shape id="_x0000_i1025" type="#_x0000_t75" style="width:6in;height:360.5pt"><v:imagedata r:id="rId10" o:title="HotIronWholeBodyNMExample"/></v:shape></w:pict></w:r></w:p></w:tc></w:tr></w:tbl><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="FigureTitle"/></w:pPr><w:r><w:t>F</w:t></w:r><w:r><w:t>igure B.1.1.1-1</w:t></w:r><w:r><w:br/><w:t>Nuclear Medicine image with and without Hot Iron Palette applied.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:pPr><w:pStyle w:val="Heading4"/></w:pPr><w:bookmarkStart w:id="43" w:name="_Toc123636742"/><w:bookmarkStart w:id="44" w:name="_Toc172346076"/><w:r><w:t>B.1.1.2 Hot Iron Color Palette Definition</w:t></w:r><w:bookmarkEnd w:id="43"/><w:bookmarkEnd w:id="44"/></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t>The ICC Profile shall define the sRGB space.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t xml:space="preserve">The value of Content Label </w:t></w:r><w:r><w:rPr><w:lang w:bidi="ar-SA"/></w:rPr><w:t>(0070,0080) shall be “HOT_IRON”.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E8714F"><w:r><w:t>This color palette is defin</w:t></w:r><w:r><w:t>ed to contain the values for Red Palette Color Lookup Table Descriptor (0028,1101), Green Palette Color Lookup Table Descriptor (0028,1102) and Blue Palette Color Lookup Table Descriptor (0028,1103) defined in Table B.1.1.2-1.</w:t></w:r></w:p><w:p w:rsidR="00000000" w:rsidRDefault="00E87