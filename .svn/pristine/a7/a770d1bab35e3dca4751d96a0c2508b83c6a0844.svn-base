        <member name="T:ClearCanvas.Common.UsageTracking.UsageTrackingThread">
            <summary>
            Enum for specifying if a Usage Tracking message will be sent on the current thread or a background thread.
            </summary>
        </member>
        <member name="F:ClearCanvas.Common.UsageTracking.UsageTrackingThread.Background">
            <summary>
            The Usage Tracking message will be sent on a background thread
            </summary>
        </member>
