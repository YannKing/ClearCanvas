        <member name="F:ClearCanvas.Common.Statistics.RateType.CUSTOM">
            <summary>
            Custom rate statistics.
            </summary>
        </member>
        <member name="T:ClearCanvas.Common.Statistics.RateStatistics">
            <summary>
            Statistics class to store the rate of changes of the underlying information.
            </summary>
            <remarks>
            The information being supported include: Byte rates or Message rate. The number of bytes or messages is set by calling <see cref="M:ClearCanvas.Common.Statistics.RateStatistics.SetData(System.Double)"/>.
            The rate will be calculated based on the value set by calling <see cref="M:ClearCanvas.Common.Statistics.RateStatistics.SetData(System.Double)"/> in between <see cref="M:ClearCanvas.Common.Statistics.RateStatistics.Start"/> and <see cref="M:ClearCanvas.Common.Statistics.RateStatistics.End"/> calls.
            
            <see cref="P:ClearCanvas.Common.Statistics.IStatistics.FormattedValue"/> of the <see cref="T:ClearCanvas.Common.Statistics.RateStatistics"/> has unit of "GB/s", "MB/s", "KB/s" or "msg/s"
            depending on type of value specified in the constructor.
            
            
            <example>
            <code>
                RateStatistics transferSpeed = new RateStatistics("Speed", RateType.BYTES);
                transferSpeed.Begin();
                transferSpeed.SetData(2408);
                transferSpeed.End();    
            </code>
            
            <para>If the time elapsed between Begin() and End() is one second, then transferSpeed.FormattedValue = "2 KB/s"</para>
            <para>If the time elapsed is 5 seconds, then transferSpeed.FormattedValue = "0.4 KB/s"</para>
            
            </example>
            
            
            
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.RateStatistics.#ctor(System.String,ClearCanvas.Common.Statistics.RateType)">
            <summary>
            Creates an instance of <see cref="T:ClearCanvas.Common.Statistics.RateStatistics"/> for the specified <see cref="T:ClearCanvas.Common.Statistics.RateType"/>
            </summary>
            <param name="name"></param>
            <param name="rateType"></param>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.RateStatistics.#ctor(System.String,System.String)">
             <summary>
            Creates an instance of <see cref="T:ClearCanvas.Common.Statistics.RateStatistics"/> for type <see cref="F:ClearCanvas.Common.Statistics.RateType.CUSTOM"/>.
             </summary>
             <param name="name"></param>
             <param name="unit"></param>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.RateStatistics.#ctor(ClearCanvas.Common.Statistics.RateStatistics)">
            <summary>
