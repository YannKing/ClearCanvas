            <summary>获取与指定类型对应的<see cref ="T:ClearCanvas.Common.TypeRef"/>。</summary>
        </member>
        <member name="M:ClearCanvas.Common.TypeRef.Get(System.Type)">
            <summary>获取与指定类型对应的<see cref ="T:ClearCanvas.Common.TypeRef"/>。 </summary>
        </member>
        <member name="M:ClearCanvas.Common.TypeRef.#ctor(System.String,System.Type)">
            <summary>私人构造函数。</summary>
        </member>
        <member name="M:ClearCanvas.Common.TypeRef.#ctor(System.String)">
            <summary>私有构造函数。</summary>
        </member>
        <member name="P:ClearCanvas.Common.TypeRef.FullName">
            <summary>获取引用类型的全名。</summary>
        </member>
        <member name="P:ClearCanvas.Common.TypeRef.AssemblyName">
            <summary>获取定义类型的程序集的名称。</summary>
        </member>
        <member name="M:ClearCanvas.Common.TypeRef.op_Implicit(System.Type)~ClearCanvas.Common.TypeRef">
            <summary>将<see cref ="T:System.Type"/>转换为<see cref ="T:ClearCanvas.Common.TypeRef"/>。</summary>
        </member>
        <member name="T:ClearCanvas.Common.AssemblyRef">
             <summary>表示对<see cref ="T:System.Reflection.Assembly"/>对象的引用。</summary>
             <remarks>
             <para>
             要获得<see cref ="T:ClearCanvas.Common.AssemblyRef"/>实例，请使用<see cref ="M:ClearCanvas.Common.AssemblyRef.Get(System.String)"/>的重载。
             或者，可以将现有的<see cref ="T:System.Reflection.Assembly"/>对象隐式地转换为<see cref ="T:ClearCanvas.Common.AssemblyRef"/>实例。
            
             To obtain an <see cref="T:ClearCanvas.Common.AssemblyRef"/> instance, use an overload of <see cref="M:ClearCanvas.Common.AssemblyRef.Get(System.String)"/>.
             Alternatively, an existing <see cref="T:System.Reflection.Assembly"/> object can be implicitly cast to an
             <see cref="T:ClearCanvas.Common.AssemblyRef"/> instance.
             </para>
             <para>此类的实例是不可变的，并且对多个线程的并发访问是安全的。
             
             Instances of this class are immutable and safe for concurrent access by multiple threads.
             </para>
             </remarks>
        </member>
        <member name="T:ClearCanvas.Common.AssemblyRef.SerializationSurrogate">
            <summary>序列化助手类。</summary>
        </member>
