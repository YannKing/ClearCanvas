        <member name="T:ClearCanvas.Common.Statistics.TimeSpanStatistics">
            <summary>
            Statistics class to track a timespan.
            </summary>
            <remarks>
            <see cref="P:ClearCanvas.Common.Statistics.IStatistics.FormattedValue"/> of the <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/> has unit of "sec", "ms", "min", "hr" depending on the elapsed time
            between <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End"/> calls. The number of ticks between these calls is stored in <see cref="P:ClearCanvas.Common.Statistics.Statistics`1.Value"/>.
            
            <example>
            <code>
                TimeSpanStatistics ts = new TimeSpanStatistics("Time");
                transferSpeed.Begin();
                ....
                transferSpeed.End();
            </code>
            
            <para>If the time elapsed between Begin() and End() is 90 second, then ts.FormattedValue = "1 min 30 sec"</para>
            <para>If the time elapsed is 300 miliseconds, then ts.FormattedValue = "300ms"</para>
            
            <para>
            <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/> also supports <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Add(ClearCanvas.Common.Statistics.TimeSpanStatistics)"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Subtract(ClearCanvas.Common.Statistics.TimeSpanStatistics)"/> for timespan 
            arithmetics.
            </para>
            
            </example>
            
            
            
            </remarks>
            
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.#ctor">
            <summary>
            Creates an instance of <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/>
            </summary>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.#ctor(System.String)">
            <summary>
            Creates an instance of <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/> with a specified name.
            </summary>
            <param name="name">Name of the <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/> instance to be created</param>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.#ctor(ClearCanvas.Common.Statistics.TimeSpanStatistics)">
            <summary>
            Creates a copy of the orginal <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/> object.
            </summary>
            <param name="copy"></param>
        </member>
        <member name="P:ClearCanvas.Common.Statistics.TimeSpanStatistics.IsSet">
            <summary>
            Gets a value indiating whether or not the value of the statistics has been set.
            </summary>
        </member>
        <member name="P:ClearCanvas.Common.Statistics.TimeSpanStatistics.IsRunning">
            <summary>
            Gets a value indicating whether or not the statistics is still being recorded 
            </summary>
            <remarks>
            After after <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start"/> is called, the statistics will be in running state until <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End"/> is called.
            </remarks>
        </member>
        <member name="P:ClearCanvas.Common.Statistics.TimeSpanStatistics.ElapsedTick">
            <summary>
            Gets the total elapsed time measured, in timer ticks.
            </summary>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Reset">
            <summary>
            Resets the current statistics.
            </summary>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Add(ClearCanvas.Common.Statistics.TimeSpanStatistics)">
            <summary>
            Adds a duration to the current <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/>.
            </summary>
            <param name="duration"></param>
            <remarks>
            Duration set using <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Add(ClearCanvas.Common.Statistics.TimeSpanStatistics)"/> will
            be lost if <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End"/> are called.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Add(ClearCanvas.Common.Statistics.TimeSpanStatisticsHelper.ExecutationBlock)">
            <summary>
            Executes and measures the duration of the specified call.
            </summary>
            <param name="codeDelegate">a delegate to an executation block</param>
            <remarks>
            This method provides a convenient mean to capture the elapsed time of the code block. 
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Add(System.Int64)">
            <summary>
            Adds a number of ticks to the current <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/>.
            </summary>
            <param name="ticks"></param>
            <remarks>
            Duration set using <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Add(System.Int64)"/> will
            be lost if <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End"/> are called.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Subtract(System.Int64)">
            <summary>
            Subtract a number of ticks from the current <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/>.
            </summary>
            <param name="ticks"></param>
            <remarks>
            Duration set using <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Subtract(System.Int64)"/> will
            be lost if <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End"/> are called.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Subtract(ClearCanvas.Common.Statistics.TimeSpanStatistics)">
            <summary>
            Adds a duration to the current <see cref="T:ClearCanvas.Common.Statistics.TimeSpanStatistics"/>.
            </summary>
            <param name="duration">The duration </param>
            <remarks>
            Duration set using <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Subtract(ClearCanvas.Common.Statistics.TimeSpanStatistics)"/> will
            be lost if <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End"/> are called.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start">
            <summary>
            Signals the beginning of the period to be measured.
            </summary>
        </member>
        <member name="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End">
            <summary>
            Signals the end of the period to be measured.
            </summary>
            <remarks>
            Any value set using <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Add(ClearCanvas.Common.Statistics.TimeSpanStatistics)"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Subtract(ClearCanvas.Common.Statistics.TimeSpanStatistics)"/> will
            be lost. The <see cref="P:ClearCanvas.Common.Statistics.Statistics`1.Value"/>  will be the elapsed time between <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.Start"/> and <see cref="M:ClearCanvas.Common.Statistics.TimeSpanStatistics.End"/>
            </remarks>
        </member>
