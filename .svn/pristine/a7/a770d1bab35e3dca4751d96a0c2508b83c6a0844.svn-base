            <returns>A <see cref="T:ClearCanvas.Common.Specifications.TestResult"/> object describing the results.</returns>
        </member>
        <member name="T:ClearCanvas.Common.Actions.IXmlActionCompilerOperator`1">
            <summary>
            Defines an interface to an operator for use with <see cref="T:ClearCanvas.Common.Actions.XmlActionCompiler`1"/>.
            </summary>
        </member>
        <member name="P:ClearCanvas.Common.Actions.IXmlActionCompilerOperator`1.OperatorTag">
            <summary>
