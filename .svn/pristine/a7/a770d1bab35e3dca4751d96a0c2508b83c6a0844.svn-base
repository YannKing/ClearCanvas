            <summary>
            The type of information used in <see cref="T:ClearCanvas.Common.Statistics.RateStatistics"/>.
            </summary>
        </member>
        <member name="F:ClearCanvas.Common.Statistics.RateType.BYTES">
            <summary>
             Rate statistics in number of bytes within a period
            </summary>
        </member>
        <member name="F:ClearCanvas.Common.Statistics.RateType.MESSAGES">
            <summary>
            Rate statistics in number of message within a period
