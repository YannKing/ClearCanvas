        <member name="T:ClearCanvas.Common.Configuration.ISettingsStore">
            <summary>
            Defines the interface to a mechanism for the storage of application and user settings.
            </summary>
            <remarks>
            This interface is more specialized than <see cref="T:ClearCanvas.Common.Configuration.IConfigurationStore"/>, in that it is designed
            specifically to support derivatives of the <see cref="T:System.Configuration.SettingsProvider"/> class in order to support the .NET 
            settings framework.
            </remarks>
        </member>
        <member name="P:ClearCanvas.Common.Configuration.ISettingsStore.IsOnline">
            <summary>
            Gets whether or not the settings store is online, and can be used.
            </summary>
        </member>
