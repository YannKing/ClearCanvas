        <member name="T:ClearCanvas.Common.TypeRef">
            <summary>
            Represents a reference to a <see cref="T:System.Type"/> object.
            </summary>
            <remarks>
            <para>
            To obtain a <see cref="T:ClearCanvas.Common.TypeRef"/> instance, use an overload of <see cref="M:ClearCanvas.Common.TypeRef.Get(System.String)"/>.
            Alternatively, an existing <see cref="T:System.Type"/> object can be implicitly cast to a
            <see cref="T:ClearCanvas.Common.TypeRef"/> instance.
            </para>
            <para>
            Instances of this class are immutable and safe for concurrent access by multiple threads.
            </para>
            </remarks>
        </member>
        <member name="T:ClearCanvas.Common.TypeRef.SerializationSurrogate">
            <summary>序列化助手类。</summary>
        </member>
