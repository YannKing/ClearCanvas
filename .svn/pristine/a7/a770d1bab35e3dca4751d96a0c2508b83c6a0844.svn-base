            <param name="args"></param>
            <exception cref="T:ClearCanvas.Common.Utilities.CommandLineException">
            Thrown if any error occurs attempting to parse the arguments, or if required arguments 
            are missing.
            </exception>
        </member>
        <member name="M:ClearCanvas.Common.Utilities.CommandLine.TryParse(System.String[],ClearCanvas.Common.Utilities.CommandLineException@)">
            <summary>
            Parses the specified argument list, using the results to populate the contents of this instance.
