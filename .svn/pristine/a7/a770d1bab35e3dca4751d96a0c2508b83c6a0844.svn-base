        <member name="P:ClearCanvas.Common.Platform.Time">
            <summary>
            Gets the current time from an extension of <see cref="T:ClearCanvas.Common.TimeProviderExtensionPoint"/>, if one exists.
            </summary>
            <remarks>
            <para>
            The time returned may differ from the current time on this machine, because the provider may choose
            to obtain the time from another source (i.e. a server).
            </para>
            <para>
            This method is thread-safe.
            </para>
            </remarks>
        </member>
        <member name="P:ClearCanvas.Common.Platform.UtcTime">
            <summary>
            Gets the current time in UTC from an extension of <see cref="T:ClearCanvas.Common.TimeProviderExtensionPoint"/>, if one exists.
            </summary>
            <remarks>
            <para>
            The time returned may differ from the current time on this machine, because the provider may choose
            to obtain the time from another source (i.e. a server).
            </para>
            <para>
            This method is thread-safe.
            </para>
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Platform.StartApp(ClearCanvas.Common.ExtensionFilter,System.String[])">
            <summary>启动应用程序。</summary>
            <param name="applicationRootFilter">一个扩展过滤器，用于选择要执行的应用程序根扩展。</param>
            <param name="args">从命令行传递的参数集。</param>
            <remarks>通过调用此方便方法启动基于ClearCanvas的应用程序某种类型的bootstrap可执行文件。
            调用此方法会导致加载所有插件并创建<see cref ="T:ClearCanvas.Common.IApplicationRoot"/>扩展名。
            此方法不是线程安全的，因为它应该只在每次执行时由单个线程调用一次。
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Platform.StartApp">
            <summary>
            Starts the application.
            </summary>
            <remarks>
            A ClearCanvas based application is started by calling this convenience method from
            a bootstrap executable of some kind.  Calling this method results in the loading
            of all plugins and creation of an <see cref="T:ClearCanvas.Common.IApplicationRoot"/> extension.  
            This method is not thread-safe as it should only ever be invoked once per execution, by a single thread.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Platform.StartApp(System.String,System.String[])">
            <summary>启动与指定的完全或部分限定类名匹配的应用程序。</summary>
            <param name="appRootClassName">应用程序根类的名称，不需要完全限定。</param>
            <param name="args"></param>
        </member>
        <member name="M:ClearCanvas.Common.Platform.GetService``1">
            <summary>获取应用程序使用的指定服务的实例。</summary>
            <remarks>此方法是线程安全的。</remarks>
            <typeparam name="TService">要获得的服务类型。</typeparam>
            <returns>指定服务的实例。</returns>
            <exception cref="T:ClearCanvas.Common.UnknownServiceException">无法提供所请求的服务。</exception>
