            <summary>
            Execute all actions in the list, returning an aggregate result.
            </summary>
            <param name="context">The context used by the <see cref="T:System.Action`1"/> instances in the set.</param>
            <returns>A <see cref="T:ClearCanvas.Common.Specifications.TestResult"/> instance telling the result of executing the actions.</returns>
        </member>
        <member name="T:ClearCanvas.Common.Actions.IActionItem`1">
            <summary>
            Performs an action using an implementation specific context.
            </summary>
        </member>
        <member name="M:ClearCanvas.Common.Actions.IActionItem`1.Execute(`0)">
            <summary>
            Executes the action.
            </summary>
            <param name="context">An implementation specific context for the action.</param>
            <returns>true on success, false on failure.</returns>
        </member>
        <member name="T:ClearCanvas.Common.Actions.IActionList`1">
            <summary>
            Interface representing a compiled set of actions returned by <see cref="T:ClearCanvas.Common.Actions.XmlActionCompiler`1"/>.
            </summary>
        </member>
        <member name="M:ClearCanvas.Common.Actions.IActionList`1.Execute(`0)">
            <summary>
