        <member name="T:ClearCanvas.Common.UnknownServiceException">
            <summary>
            Used internally by the framework to indicate an error when attempting to load/use a service.
            </summary>
        </member>
        <member name="T:ClearCanvas.Common.Utilities.IBackgroundTaskContext">
            <summary>
            Allows the background thread to communicate with the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTask"/> object.
            </summary>
            <remarks>
            The background thread should not directly access the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTask"/> object.
            </remarks>
        </member>
        <member name="P:ClearCanvas.Common.Utilities.IBackgroundTaskContext.UserState">
            <summary>
            Provides access to the user state object.
            </summary>
            <remarks>
            The user state object is available to both threads, and therefore it should either be immutable or thread-safe.
            </remarks>
        </member>
        <member name="P:ClearCanvas.Common.Utilities.IBackgroundTaskContext.CancelRequested">
            <summary>
            Allows the background thread to ask whether cancellation has been requested.
            </summary>
            <remarks>
            If possible, the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> should periodically poll this flag, 
            and if true, terminate as quickly as possible without completing its work.  
            It should call <see cref="M:ClearCanvas.Common.Utilities.IBackgroundTaskContext.Cancel"/> to confirm cancellation.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Utilities.IBackgroundTaskContext.ReportProgress(ClearCanvas.Common.Utilities.BackgroundTaskProgress)">
            <summary>
            Allows the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> to report progress to the foreground thread.
            </summary>
            <remarks>
            The progress object may be an instance of <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskProgress"/> or a derived class.</remarks>
        </member>
        <member name="M:ClearCanvas.Common.Utilities.IBackgroundTaskContext.Complete(System.Object[])">
            <summary>
            Allows the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> to inform that it has completed successfully, and return the result objects
            to the foreground thread.
            </summary>
            <remarks>
            After calling this method, the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> should simply exit.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Utilities.IBackgroundTaskContext.Cancel">
            <summary>
            Allows the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> to inform that it has successfully cancelled,
            in response to querying the <see cref="P:ClearCanvas.Common.Utilities.IBackgroundTaskContext.CancelRequested"/> flag, and return the result object
            to the foreground thread.
            </summary>
            <remarks>
            After calling this method, the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> should simply exit.
            </remarks>
        </member>
        <member name="M:ClearCanvas.Common.Utilities.IBackgroundTaskContext.Error(System.Exception)">
            <summary>
            Allows the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> to inform that it cannot complete due to an exception,
            and return the exception to the foreground thread.
            </summary>
            <remarks>
            After calling this method, the <see cref="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod"/> should simply exit.  
            It is technically ok for the background method to allow an exception to go unhandled, 
            an the unhandled exception will still be reported to the foreground thread as an error.  
            However, the VS debugger will break in this case, which may not be desirable.
            </remarks>
        </member>
        <member name="T:ClearCanvas.Common.Utilities.BackgroundTaskMethod">
            <summary>
            Defines the signature for a method that is to be executed as a background task.
            </summary>
        </member>
